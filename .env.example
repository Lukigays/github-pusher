# ================== SERVER ==================
PORT=3000
HOST=0.0.0.0

# URL publik aplikasi ini (dipakai untuk callback OAuth).
# Kosongkan saat development -> otomatis pakai http://localhost:3000
# Isi dengan domain Anda saat deploy, contoh: https://pusher.domainku.com
PUBLIC_URL=

# Rahasia sesi (ganti dengan string acak panjang!)
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# ================== LOGIN GITHUB (OAuth App) ==================
# Buat di: https://github.com/settings/developers -> OAuth Apps -> New OAuth App
#   Homepage URL            : http://localhost:3000
#   Authorization callback  : http://localhost:3000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Scope: "repo" = akses repo privat & publik (dibutuhkan untuk push).
# Ganti jadi "public_repo" bila hanya repo publik.
GITHUB_SCOPE=repo

# Untuk GitHub Enterprise Server, contoh: https://github.perusahaan.com/api/v3
GITHUB_API_URL=https://api.github.com

# Jumlah request paralel saat mengunggah blob (1-10)
GITHUB_CONCURRENCY=5

# ================== LOGIN GOOGLE (opsional) ==================
# Buat di: https://console.cloud.google.com/apis/credentials -> OAuth Client ID (Web)
#   Authorized JavaScript origins: http://localhost:3000
GOOGLE_CLIENT_ID=

# ================== MODE DEMO ==================
# Saat GITHUB_CLIENT_ID/SECRET kosong, aplikasi jalan sebagai mode demo.
# 1 = izinkan tombol "push ke GitHub tiruan" (simulasi in-memory, tanpa token)
# 0 = matikan (push hanya dry-run)
ALLOW_MOCK_PUSH=1

# Token tetap untuk server pribadi (opsional). Bila diisi, semua sesi memakainya.
GITHUB_TOKEN=

# ================== BATASAN UPLOAD ==================
# Ukuran maksimum file ZIP / total upload folder
MAX_UPLOAD_MB=512
# Jumlah maksimum file dalam satu push
MAX_FILES=20000
# Lokasi folder kerja sementara
TMP_DIR=./data/tmp
