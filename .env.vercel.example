# ==================================================================
# .env untuk deploy VERCEL (serverless)
# Salin isinya ke: Dashboard Vercel → Project → Settings → Environment Variables
# (JANGAN commit file .env asli ke git.)
# ==================================================================

# WAJIB. string acak panjang — harus SAMA di semua environment,
# kalau tidak cookie sesi tidak terbaca dan login "hilang" tiap request.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# WAJIB untuk login GitHub. Callback URL yang didaftarkan di OAuth App:
#   https://NAMA-PROYEK.vercel.app/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_SCOPE=repo
GITHUB_API_URL=https://api.github.com
GITHUB_CONCURRENCY=5

# URL publik aplikasi (opsional). Bila kosong, diambil otomatis dari header request.
PUBLIC_URL=https://NAMA-PROYEK.vercel.app

# Login Google (opsional). Tambahkan origin https://NAMA-PROYEK.vercel.app
# di "Authorized JavaScript origins" pada kredensial Google.
GOOGLE_CLIENT_ID=

# Mode demo: 1 = izinkan "push ke GitHub tiruan" (in-memory) untuk mencoba alur.
# Set 0 di produksi bila tidak diinginkan.
ALLOW_MOCK_PUSH=1

# ---- Batas khas Vercel (JANGAN dinaikkan) ----
# Di Vercel nilai ini DIKUNCI 4,3 MB oleh aplikasi (Vercel menolak body > 4,5 MB
# dengan 413 FUNCTION_PAYLOAD_TOO_LARGE sebelum fungsi terpanggil). Baris ini
# hanya berpengaruh bila Anda menjalankan mode serverless di tempat lain.
MAX_UPLOAD_MB=4.3
# Semua file ditampung di RAM fungsi (maks 1-2 GB) -> batasi jumlah file.
MAX_FILES=300

# Tidak dipakai di Vercel (tidak ada disk persisten), biarkan default.
TMP_DIR=/tmp/gzp
